---
import { loc, type Locale } from "@/i18n/ui";
import { groupMedia, isVideo } from "@/lib/projects";
import { SIZES, responsiveImage } from "@/lib/media";
import type { CollectionEntry } from "astro:content";

type Media = CollectionEntry<"projets">["data"]["media"][number];

interface Props {
  media: Media[];
  locale: Locale;
  /** Set on the first visible media row so it is prioritised. */
  priority?: boolean;
}
const { media, locale, priority = false } = Astro.props;
const rows = groupMedia(media);
// src (a variant, never the uploaded original), srcset and dimensions per image.
const images = new Map(
  await Promise.all(
    media
      .filter((item) => !isVideo(item.src))
      .map(
        async (item) =>
          [
            item.src,
            await responsiveImage(item.src, {
              width: item.width,
              height: item.height,
            }),
          ] as const
      )
  )
);
let seen = 0;
---

<div class="flex flex-col gap-1">
  {rows.map((row) => (
    <div
      class:list={[
        "grid gap-1",
        row.length === 2 ? "grid-cols-2" : "grid-cols-1",
      ]}
    >
      {row.map((item) => {
        const index = seen++;
        const alt = loc(item, "caption", locale);
        const eager = priority && index === 0;
        const image = images.get(item.src);
        return isVideo(item.src) ? (
          <video
            controls
            playsinline
            preload={eager ? "metadata" : "none"}
            poster={item.poster}
            width={item.width}
            height={item.height}
            class="w-full bg-placeholder"
          >
            <source src={item.src} type="video/mp4" />
          </video>
        ) : (
          <img
            src={image?.src ?? item.src}
            srcset={image?.srcset}
            sizes={
              image?.srcset
                ? row.length === 2
                  ? SIZES.mediaHalf
                  : SIZES.mediaFull
                : undefined
            }
            alt={alt}
            width={image?.width ?? item.width}
            height={image?.height ?? item.height}
            loading={eager ? "eager" : "lazy"}
            fetchpriority={eager ? "high" : undefined}
            decoding="async"
            class="w-full bg-placeholder"
          />
        );
      })}
    </div>
  ))}
</div>
