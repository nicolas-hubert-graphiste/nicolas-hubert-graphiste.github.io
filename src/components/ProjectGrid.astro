---
import { getEntry } from "astro:content";
import { loc, t, type Locale } from "@/i18n/ui";
import { coverOf, projectPath, type Projet } from "@/lib/projects";
import { SIZES, responsiveImage } from "@/lib/media";

interface Props {
  projects: Projet[];
  locale: Locale;
}
const { projects, locale } = Astro.props;
const tr = t(locale);

const cards = await Promise.all(
  projects.map(async (projet) => {
    const client = await getEntry(projet.data.client);
    const cover = coverOf(projet);
    return {
      href: projectPath(locale, projet.id),
      title: loc(projet.data, "title", locale),
      client: client ? loc(client.data, "short", locale) : "",
      // Cards are cropped to 4:3, so the 1280px variant is the default source.
      cover: cover
        ? await responsiveImage(cover.src, {
            width: cover.width,
            height: cover.height,
            prefer: "large",
            measureIfUnknown: false,
          })
        : undefined,
      nouveau: projet.data.nouveau,
    };
  })
);
---

<ul class="grid grid-cols-1 gap-x-5 gap-y-8 md:grid-cols-2 lg:grid-cols-3 lg:gap-y-10">
  {cards.map((card, index) => (
    <li>
      <a href={card.href} class="group block">
        {card.cover ? (
          <img
            src={card.cover.src}
            srcset={card.cover.srcset}
            sizes={card.cover.srcset ? SIZES.grid : undefined}
            width={card.cover.width}
            height={card.cover.height}
            alt=""
            class="aspect-[4/3] w-full bg-placeholder object-cover"
            loading={index < 3 ? "eager" : "lazy"}
            fetchpriority={index === 0 ? "high" : undefined}
            decoding="async"
          />
        ) : (
          <div class="aspect-[4/3] w-full bg-placeholder" />
        )}
        {/* One line each: long titles and client names end in an ellipsis. */}
        <div class="mt-2 flex min-w-0 items-center gap-2 text-base">
          <p class="min-w-0 truncate" title={card.title}>
            {card.title}
          </p>
          {card.nouveau && (
            <span class="inline-flex h-[15px] shrink-0 items-center rounded-[2px] bg-placeholder px-[5px] text-xs leading-none tracking-[0.02em] text-black/55 uppercase">
              {tr("project.new")}
            </span>
          )}
        </div>
        <p class="truncate text-base text-gray" title={card.client}>
          {card.client}
        </p>
      </a>
    </li>
  ))}
</ul>
