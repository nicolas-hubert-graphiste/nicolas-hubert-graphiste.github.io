---
import { getEntry } from "astro:content";
import { loc, type Locale } from "@/i18n/ui";
import { coverOf, projectPath, type Projet } from "@/lib/projects";
import { SIZES, responsiveImage } from "@/lib/media";

interface Props {
  projects: Projet[];
  locale: Locale;
}
const { projects, locale } = Astro.props;

const cards = await Promise.all(
  projects.map(async (projet) => {
    const client = await getEntry(projet.data.client);
    const cover = coverOf(projet);
    return {
      href: projectPath(locale, projet.id),
      title: loc(projet.data, "title", locale),
      client: client ? loc(client.data, "short", locale) : "",
      // Cards are cropped to 3:2, so the 1280px variant is the default source.
      cover: cover
        ? await responsiveImage(cover.src, {
            width: cover.width,
            height: cover.height,
            prefer: "large",
            measureIfUnknown: false,
          })
        : undefined,
    };
  })
);
---

{/*
  Section index (site_nhab_2026_ordi p.5, site_nh_2026_iPhone p.5): 3:2 covers
  5px apart, with the title and client set tight underneath. Phones get one
  column and 12px captions; from tablets up, 14px captions on a 17px line.
*/}
<ul class="grid grid-cols-1 gap-x-1 gap-y-[12.25px] md:grid-cols-2 md:gap-y-[16px] lg:grid-cols-3">
  {cards.map((card, index) => (
    <li>
      <a href={card.href} class="group block">
        {card.cover ? (
          <img
            src={card.cover.src}
            srcset={card.cover.srcset}
            sizes={card.cover.srcset ? SIZES.grid : undefined}
            width={card.cover.width}
            height={card.cover.height}
            alt=""
            class="aspect-[3/2] w-full bg-placeholder object-cover"
            loading={index < 3 ? "eager" : "lazy"}
            fetchpriority={index === 0 ? "high" : undefined}
            decoding="async"
          />
        ) : (
          <div class="aspect-[3/2] w-full bg-placeholder" />
        )}
        {/* One line each: long titles and client names end in an ellipsis. */}
        <div class="mt-[6.25px] text-sm md:mt-[7.75px] md:text-base md:leading-[17px]">
          <p class="truncate" title={card.title}>
            {card.title}
          </p>
          <p class="truncate text-gray" title={card.client}>
            {card.client}
          </p>
        </div>
      </a>
    </li>
  ))}
</ul>
