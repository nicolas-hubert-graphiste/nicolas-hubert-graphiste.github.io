---
import { getEntry } from "astro:content";
import Base from "@/layouts/Base.astro";
import ProjectNav from "@/components/ProjectNav.astro";
import RichText from "@/components/RichText.astro";
import { loc, t, type Locale } from "@/i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);
const contact = await getEntry("contact", "contact");
const data = contact?.data;
---

<Base locale={locale} title={tr("nav.contact")}>
  {data && (
    <div class="flex max-w-[60ch] flex-col gap-[1lh] text-lg lg:text-base">
      <div>
        <p>{data.name}</p>
        <RichText text={data.address} />
      </div>
      {(data.phone || data.email) && (
        <div>
          {data.phone && <p>tél. {data.phone}</p>}
          {data.email && (
            <p>
              <a
                href={`mailto:${data.email}`}
                class="underline underline-offset-2"
              >
                {data.email}
              </a>
            </p>
          )}
        </div>
      )}
      {data.bookRequest && (
        <div>
          <p>{loc(data.bookRequest, "label", locale)}</p>
          {data.bookRequest.emails.map((email) => (
            <p>
              <a href={`mailto:${email}`} class="underline underline-offset-2">
                {email}
              </a>
            </p>
          ))}
        </div>
      )}
      {data.instagram && (
        <p>
          <a
            href={data.instagram}
            target="_blank"
            rel="noopener"
            class="underline underline-offset-2"
          >
            Instagram
          </a>
        </p>
      )}
      {loc(data, "credit", locale) && (
        <RichText text={loc(data, "credit", locale)} />
      )}
    </div>
  )}
  <ProjectNav locale={locale} />
</Base>
