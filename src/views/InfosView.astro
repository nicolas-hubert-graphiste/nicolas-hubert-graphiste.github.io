---
import { getEntry } from "astro:content";
import Base from "@/layouts/Base.astro";
import ContactBlock from "@/components/ContactBlock.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import RichText from "@/components/RichText.astro";
import { loc, t, type Locale } from "@/i18n/ui";

/*
 * "Infos, contact": Studio, Collaborations, Clients and Contact. Four columns
 * on desktop (15px apart, site_nhab_2026_ordi p.16), two on tablets, and one
 * on phones with a hairline between sections (site_nh_2026_iPhone p.10-12).
 * The first three come from `infos.yml`, the last from `contact.yml`.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);
const infos = await getEntry("infos", "infos");
const data = infos?.data;
const team = data?.team?.names?.trim() ? data.team : undefined;

/** Stacked sections are separated by a hairline; columns are not. */
const section = "border-b-[0.5px] border-current pb-10 md:border-b-0 md:pb-0";
const heading = "mb-5 text-4xl";
/** Sub-headed groups sit half a line apart on phones, a full line on desktop. */
const groups = "flex flex-col gap-[0.5lh] lg:gap-[1lh]";
---

<Base locale={locale} title={tr("nav.infosContact")} sections={["infos"]}>
  {data && (
    <div class="grid grid-cols-1 gap-x-3 gap-y-10 text-lg md:grid-cols-2 lg:grid-cols-4 lg:text-base">
      <section class={section}>
        <h1 class={heading}>{tr("infos.studio")}</h1>
        <div class={groups}>
          <RichText text={loc(data, "studio", locale)} />
          {team && (
            <div>
              {loc(team, "heading", locale) && (
                <h2 class="font-medium">{loc(team, "heading", locale)}</h2>
              )}
              <RichText text={team.names} />
            </div>
          )}
        </div>
      </section>

      <section class={section}>
        <h2 class={heading}>{tr("infos.collaborations")}</h2>
        <div class={groups}>
          {data.collaborations.map((group) => (
            <div>
              {loc(group, "heading", locale) && (
                <h3 class="font-medium">{loc(group, "heading", locale)}</h3>
              )}
              <RichText text={group.names} />
            </div>
          ))}
        </div>
      </section>

      <section class={section}>
        <h2 class={heading}>{tr("infos.clients")}</h2>
        <div class={groups}>
          {data.clients.map((group) => (
            <div>
              {loc(group, "heading", locale) && (
                <h3 class="font-medium">{loc(group, "heading", locale)}</h3>
              )}
              <RichText text={group.names} />
            </div>
          ))}
        </div>
      </section>

      {/* Old /contact/ links land here, clear of the sticky header. */}
      <section id="contact" class="scroll-mt-[80px] lg:scroll-mt-[112px]">
        <h2 class={heading}>{tr("infos.contact")}</h2>
        <ContactBlock locale={locale} />
      </section>
    </div>
  )}
  <SiteFooter slot="footer" locale={locale} />
</Base>
